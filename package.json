{
  "name": "skelcrew",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome ci .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "fix": "biome check --write .",
    "daemon": "bun packages/daemon/src/main.ts",
    "skelcrew": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
